---
// Thin redirect to the Heylo join page. Per spec, signup links route through
// norcalevs.org/join rather than deep-linking to Heylo.
const target = "https://heylo.group/norcalevs";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Joining NorCal EVs</title>
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="theme-color" content="#f2e8d5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#07110d" media="(prefers-color-scheme: dark)" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&display=swap"
    />
    <style>
      :root { color-scheme: light dark; }
      body {
        margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
        font-family: "Archivo", system-ui, sans-serif; background: #f2e8d5; color: #07110d;
        text-align: center; padding: 24px; line-height: 1.6;
      }
      main { max-width: 34rem; padding: 36px; border: 1px solid rgba(7, 17, 13, 0.2); }
      p { margin: 0 0 12px; }
      a { color: #1596a8; font-weight: 700; text-underline-offset: 4px; }
      a:focus-visible { outline: 3px solid #1596a8; outline-offset: 4px; }
      @media (prefers-color-scheme: dark) {
        body { background: #07110d; color: #f2e8d5; }
        main { border-color: rgba(242, 232, 213, 0.18); }
        a { color: #25c7dc; }
        a:focus-visible { outline-color: #25c7dc; }
      }
    </style>
  </head>
  <body>
    <main>
      <p>Taking you to the NorCal EVs community to finish joining.</p>
      <p><a href={target}>Continue to sign up</a> if you are not redirected automatically.</p>
    </main>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </body>
</html>
