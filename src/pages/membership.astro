---
import BaseLayout from "../layouts/BaseLayout.astro";

const launchClaimed = 0;
const launchTotal = 30;

const funnel = [
  { n: "01", t: "Discover", d: "Find NorCal EVs through a friend, event, or online." },
  { n: "02", t: "Learn", d: "See what the community is about." },
  { n: "03", t: "Join", d: "Choose the membership that fits." },
  { n: "04", t: "Attend", d: "Come to an event and meet people." },
  { n: "05", t: "Stay", d: "Keep showing up. That is the whole thing." },
];

const benefits = [
  "Access to every event, discussion, and member communication (all tiers)",
  "Free admission to member-only events (Long Range and up)",
  "Tier-based discounts on paid events and the NorCal EVs shop (Long Range and Max Pack)",
  "Voting rights on community decisions (Long Range and Max Pack)",
  "A NorCal EVs member sticker (Long Range and up)",
  "Real-world community: drives, meetups, and shared experiences across every brand",
];
---

<BaseLayout
  title="Membership · NorCal EVs"
  description="Pick how you want to be part of NorCal EVs. Free for everyone, with paid tiers for members who want to go deeper."
>
  <section class="interior-hero">
    <div class="container interior-hero-grid">
      <div class="interior-hero-copy">
        <span class="poster-kicker on-dark">Open membership</span>
        <h1 class="poster-title">Join in.<br /><span>Show up.</span></h1>
        <p>For EV owners, enthusiasts, and the EV-curious across Northern California. Every brand and experience level belongs.</p>
        <div class="poster-actions">
          <a href="/join" class="poster-button">Join the community</a>
          <a href="/#events" class="poster-button-ghost">Upcoming events</a>
        </div>
      </div>
      <div class="interior-hero-visual" style="background-image:url('/assets/images/community/brand-rivian.jpg')">
        <img src="/assets/images/logo-400.png" alt="NorCal EVs" />
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="poster-kicker">How it works</span>
          <h2 class="section-title" style="margin-top:18px">Five steps. No friction.</h2>
        </div>
      </div>
      <div class="funnel">
        {funnel.map((step) => (
          <div class="funnel-step">
            <span class="funnel-num">{step.n}</span>
            <div class="funnel-label">{step.t}</div>
            <p class="funnel-desc">{step.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="poster-kicker">Membership tiers</span>
          <h2 class="section-title" style="margin-top:18px">Pick what fits.</h2>
        </div>
        <p class="section-head-copy">Join for free. Paid memberships support the community and include more ways to take part.</p>
      </div>

      {launchClaimed < launchTotal && (
        <div class="promo">
          <div>
            <span class="promo-badge">Launch Edition</span>
            <h3>Long Range for $30 your first year.</h3>
            <p>A founding rate for the first 30 members. It renews at $50 per year.</p>
          </div>
          <a href="https://www.heylo.com/g/c7893068-9bd1-4f37-b713-e6907a3ebf60/membership" class="btn">Claim the launch rate</a>
        </div>
      )}

      <div class="tiers t3">
        <article class="tier">
          <div class="tier-name">Standard Range</div>
          <div class="tier-price">Free</div>
          <p class="tier-for">For anyone who wants in.</p>
          <ul>
            <li>Access to all events</li>
            <li>Community discussions and member communications</li>
            <li>A simple way to see what NorCal EVs is about</li>
          </ul>
          <a href="/join" class="btn btn-ghost">Join free</a>
        </article>

        <article class="tier feature">
          <span class="tier-badge">Best value</span>
          <div class="tier-name">Long Range</div>
          <div class="tier-price">$50 <span>/ year</span></div>
          <p class="tier-for">For members who want to go deeper.</p>
          <ul>
            <li>Everything in Standard Range</li>
            <li>Free admission to member-only events</li>
            <li>20% off paid events</li>
            <li>10% off the NorCal EVs shop</li>
            <li>Voting rights on community decisions</li>
            <li>NorCal EVs member sticker included</li>
          </ul>
          <a href="https://www.heylo.com/g/c7893068-9bd1-4f37-b713-e6907a3ebf60/membership" class="btn btn-primary">Choose Long Range</a>
        </article>

        <article class="tier">
          <div class="tier-name">Max Pack</div>
          <div class="tier-price">$500 <span>lifetime</span></div>
          <p class="tier-for">For the all-in founding supporters.</p>
          <ul>
            <li>Everything in Long Range, forever</li>
            <li>50% off paid events</li>
            <li>50% off the NorCal EVs shop at signup</li>
            <li>Permanent recognition on the website and in the community</li>
            <li>NorCal EVs member sticker included</li>
          </ul>
          <a href="https://www.heylo.com/g/c7893068-9bd1-4f37-b713-e6907a3ebf60/membership" class="btn btn-ghost">Go Max Pack</a>
        </article>
      </div>

      <p class="section-desc">Being part of NorCal EVs has always been free. Paid memberships are for people who want to support what we are building and have a say in where it goes.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="poster-kicker">What members get</span>
          <h2 class="section-title" style="margin-top:18px">Benefits, listed honestly.</h2>
        </div>
      </div>
      <ul class="list-check two-col">
        {benefits.map((benefit) => <li>{benefit}</li>)}
      </ul>
    </div>
  </section>

  <section class="section band-cta membership-closing">
    <div class="container">
      <span class="poster-kicker on-dark">All brands welcome</span>
      <h2 class="section-title">From Tesla to Kia to still deciding.</h2>
      <p>Longtime EV owners, first-time buyers, and curious newcomers all belong in the same parking lot.</p>
    </div>
  </section>
</BaseLayout>
