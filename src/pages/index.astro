---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sponsors } from "../data/sponsors";

const pillars = [
  { n: "01 / 06", t: "Events & Drives", d: "Meetups, scenic drives, and signature events across Northern California." },
  { n: "02 / 06", t: "Community Meetups", d: "Local gatherings where EV owners connect and share what they know." },
  { n: "03 / 06", t: "EV Education", d: "Useful workshops and talks on charging, road trips, and ownership." },
  { n: "04 / 06", t: "Cross-Brand Connection", d: "Tesla, Rivian, Ford, Lucid, and every other EV in one place." },
  { n: "05 / 06", t: "Partner Collaborations", d: "Local businesses and partners that strengthen the EV community." },
  { n: "06 / 06", t: "Member Community", d: "A dedicated space for members to connect, coordinate, and shape what comes next." },
];

const brands = [
  { key: "tesla", label: "Tesla" },
  { key: "rivian", label: "Rivian" },
  { key: "lucid", label: "Lucid" },
  { key: "ford", label: "Ford" },
];
---

<BaseLayout
  title="NorCal EVs · Driven by Community"
  description="Northern California's cross-brand EV community. If it plugs in, it belongs here."
>
  <section class="home-hero">
    <div class="home-hero-inner container">
      <img class="home-hero-logo" src="/assets/images/logo-400.png" alt="NorCal EVs" />
      <span class="poster-kicker on-dark">Northern California, every EV</span>
      <h1 class="poster-title">Plug in.<br /><span>Show up.</span></h1>
      <p>Meetups, drives, and good people. Every brand belongs here.</p>
      <div class="poster-actions">
        <a class="poster-button" href="/membership">Join the community</a>
        <a class="poster-button-ghost" href="#events">Upcoming events</a>
      </div>
    </div>
  </section>

  <section class="home-about">
    <div class="container home-about-grid">
      <div class="home-about-label">
        <span class="poster-kicker on-dark">About NorCal EVs</span>
      </div>
      <p class="home-about-copy">
        A registered 501(c)(7) community built for real-world connection across Northern
        California. <span>No brand boundaries. No experience required.</span>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="poster-kicker">What we're building</span>
          <h2 class="section-title" style="margin-top:18px">Real things.<br />Real community.</h2>
        </div>
        <p class="section-head-copy">Events, education, and connection that exist beyond a screen.</p>
      </div>
      <div class="poster-grid pillar-grid">
        {pillars.map((pillar) => (
          <article class="pillar-card">
            <span class="pillar-num">{pillar.n}</span>
            <div>
              <h3>{pillar.t}</h3>
              <p>{pillar.d}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="brand-photo-section">
    <div class="brand-photo-grid">
      {brands.map((brand) => (
        <figure class="brand-photo">
          <img
            src={`/assets/images/community/brand-${brand.key}.jpg`}
            alt={`${brand.label} electric vehicle`}
            loading="lazy"
            decoding="async"
          />
          <span>{brand.label}</span>
        </figure>
      ))}
    </div>
    <p class="container brand-statement">
      Tesla. Rivian. Lucid. Ford. Hyundai. Kia. BMW.
      <span>If it plugs in, you belong here.</span>
    </p>
  </section>

  <section class="section" id="events">
    <div class="container events-layout">
      <div class="events-copy">
        <span class="poster-kicker">Upcoming</span>
        <h2 class="section-title">See what is next.</h2>
        <p>Meetups, drives, show and tells, and education events. All members welcome.</p>
      </div>

      <div class="events-panel">
        <div class="events-panel-top">
          <span>Community Calendar</span>
          <a href="https://heylo.group/norcalevs" target="_blank" rel="noopener noreferrer">View all events ↗</a>
        </div>
        <div class="events-embed">
          <div class="events-status" id="heylo-event-status">Loading upcoming events...</div>
          <div
            id="heylo-event-feed"
            data-api-key="4655dcc1-deca-40d8-b6df-06ccec55c3f8"
            data-community-id="c7893068-9bd1-4f37-b713-e6907a3ebf60"
          ></div>
          <div class="events-fallback" id="heylo-event-fallback" hidden>
            <p>The live calendar is still available in our online hub if the embedded widget does not load here.</p>
            <a href="https://heylo.group/norcalevs" class="poster-button" target="_blank" rel="noopener noreferrer">View the calendar</a>
          </div>
          <script is:inline src="https://www.heylo.com/embedded-events.min.js"></script>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="poster-kicker">Our sponsors</span>
          <h2 class="section-title" style="margin-top:18px">Backing the community.</h2>
        </div>
        <p class="section-head-copy">Businesses that understand where the EV community is going.</p>
      </div>
      <div class="sponsor-grid">
        {sponsors.map((sponsor) => (
          <a class="sponsor-card" href={sponsor.url} target="_blank" rel="noopener noreferrer">
            <img class="sponsor-logo-light" src={`/assets/images/${sponsor.logo}`} alt={sponsor.name} loading="lazy" />
            {sponsor.logoDark && (
              <img class="sponsor-logo-dark" src={`/assets/images/${sponsor.logoDark}`} alt={sponsor.name} loading="lazy" />
            )}
          </a>
        ))}
      </div>
      <a class="sponsors-link link-accent" href="/sponsorships">Interested in sponsoring NorCal EVs? Learn more ↗</a>
    </div>
  </section>

  <section class="section newsletter-band">
    <div class="container newsletter-layout">
      <span class="poster-kicker">Stay connected</span>
      <h2 class="section-title">Be the first to know.</h2>
      <p>Events, community news, and what is happening across NorCal EVs.</p>
      <div class="signup-form">
        <div class="ml-embedded" data-form="AbIwuu"></div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Heylo fallback, show static CTA if the widget does not populate.
  (function () {
    var feed = document.getElementById("heylo-event-feed");
    var status = document.getElementById("heylo-event-status");
    var fallback = document.getElementById("heylo-event-fallback");
    if (!feed) return;
    var settled = false;
    function settle() {
      if (settled) return;
      settled = true;
      if (status) status.style.display = "none";
    }
    var observer = new MutationObserver(function () {
      if (feed.children.length > 0) settle();
    });
    observer.observe(feed, { childList: true, subtree: true });
    setTimeout(function () {
      if (feed.children.length === 0) {
        settle();
        if (fallback) fallback.hidden = false;
      }
    }, 3500);
  })();
</script>
